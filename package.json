{
  "name": "eatiming",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "db:seed:gen": "tsx scripts/gen-food-seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply eatiming --local",
    "db:migrate:remote": "wrangler d1 migrations apply eatiming --remote",
    "test": "vitest run --project unit && vitest run --project worker",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler d1 migrations apply eatiming --remote && wrangler deploy",
    "e2e:server": "rm -rf .wrangler/e2e && wrangler d1 migrations apply eatiming --local --persist-to .wrangler/e2e && vite build && EATIMING_PERSIST_PATH=.wrangler/e2e vite preview --strictPort",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
